# Required core app config
DATABASE_URI=postgres://user:password@host:5432/ai_agency_pipeline
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Required when calling the Python AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-a-long-random-service-token
# AI provider/model names can be edited in Payload AI Settings.
# These values are bootstrap/fallback only; API keys remain environment-only.
AI_PROVIDER=deterministic
AI_MODEL=glm-5.1
AI_API_KEY=
AI_BASE_URL=
OPENCODE_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_PROFILE_MODEL=
AI_DEMO_CONTENT_MODEL=
AI_QA_MODEL=
AI_OUTREACH_MODEL=
# Keep true for safe local/portfolio testing; real sends are blocked while true.
PORTFOLIO_MODE=true

# Required only for real email sends
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio Demo <demo@example.com>

# Required only for screenshot capture
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://assets.example.com
