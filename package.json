{
  "name": "ai-agency-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "payload": "payload",
    "dev:ai": "cd workers/python && uv run uvicorn app.main:app --reload --port 8000",
    "dev:all": "concurrently --kill-others -n next,ai -c blue,green \"npm run dev\" \"npm run dev:ai\""
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "aws4fetch": "^1.0.20",
    "cross-env": "^7.0.3",
    "next": "16.3.5",
    "payload": "3.89.0",
    "playwright": "^1.59.1",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "resend": "^6.12.3",
    "sharp": "0.35.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@aws-sdk/core": "3.974.8",
    "@aws-sdk/credential-provider-node": "3.972.39",
    "@aws-sdk/middleware-sdk-s3": "3.972.37"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "4.1.11"
  }
}
